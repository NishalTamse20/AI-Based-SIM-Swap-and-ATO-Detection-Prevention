{
  "version": "v3",
  "description": "Controlled SIM_REPLACEMENT cohorts built from shared slot skeletons. Skeletons (which slots are present and how many events) are label-neutral and shared by both labels within a family; declared intent only chooses event versions. Anchors are shared by both labels. Transactions use PaySim amounts sampled independently of label and type.",
  "design_assumptions": {
    "status": "Provisional synthetic design parameters; not empirical rates and not evidence of real-world behaviour.",
    "assumption_notes": {
      "p_new_device": "Provisional synthetic assumption: 0.5 (legitimate) vs 0.9 (suspicious). Not an empirical rate. In the approved seed-42 design audit it was the strongest single in-window signal (leave-one-family-out lookup 0.677 predictive, 0.463 negative control)."
    },
    "anchor_cases_per_label_per_family": 3,
    "variant_skeletons_per_family": 7,
    "skeleton_quotas_per_family": {
      "recovery": 4,
      "transaction": 4,
      "account": 3,
      "auth_k1": 2,
      "auth_k2": 2
    },
    "presence_per_label_cell_including_anchors": {
      "device": 10,
      "login": 10,
      "recovery": 7,
      "transaction": 4,
      "account": 3,
      "auth": 4
    },
    "negative_control_recipe_sources_per_family": {
      "anchor": 6,
      "profile_A": 7,
      "profile_B": 7
    },
    "negative_control_profile_parameters": {
      "profile_A": "legitimate",
      "profile_B": "suspicious"
    },
    "version_probabilities": {
      "legitimate": {
        "p_new_device": 0.5,
        "p_auth_failure": 0.3,
        "p_new_beneficiary": 0.3,
        "p_high_risk_transaction": 0.4
      },
      "suspicious": {
        "p_new_device": 0.9,
        "p_auth_failure": 0.7,
        "p_new_beneficiary": 0.7,
        "p_high_risk_transaction": 0.8
      }
    }
  },
  "anchor_skeleton": {
    "auth_k": 0,
    "recovery": true,
    "account": false,
    "transaction": false,
    "device_version": "new"
  },
  "ordering_rules": [
    "The SIM_REPLACEMENT trigger is at T and is the only TELECOM event.",
    "The device slot is the first event after the trigger.",
    "Account and transaction slots occur after the first authentication-slot or login-slot event.",
    "Ordering and timestamps depend only on seed, case_id and slot tokens, never on labels or versions.",
    "All other events fall within the inclusive window T+1s..T+15:00."
  ],
  "risk_account_event": "NEW_BENEFICIARY",
