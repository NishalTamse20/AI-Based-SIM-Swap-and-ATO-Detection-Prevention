  "interaction_model": {
    "status": "Provisional synthetic design parameters; not empirical rates and not evidence of real-world fraud patterns.",
    "slots": [
      "device",
      "auth",
      "account",
      "transaction"
    ],
    "risky_version": {
      "device": "new",
      "auth": "failure",
      "account": "risk",
      "transaction": "high_risk"
    },
    "q": {
      "device": 0.7,
      "auth": 0.5,
      "account": 0.5,
      "transaction": 0.6
    },
    "rho": 0.25,
    "r": {
      "device": 0.6,
      "auth": 0.3333333333333333,
      "account": 0.3333333333333333,
      "transaction": 0.4666666666666667
    },
    "independent_intents": [
      "legitimate"
    ],
    "coordinated_intents": [
      "suspicious"
    ],
    "rule": "legitimate: each latent version risky independently with probability q_s. suspicious: with probability rho all four latent versions are risky; otherwise each is risky independently with probability r_s = (q_s - rho) / (1 - rho). Marginal P(risky) equals q_s under both intents.",
    "limitations": [
      "The coupling is global (identical in every family), so a held-out family does not test an unseen interaction mechanism.",
      "The joint pattern does not establish or represent real-world fraud behaviour.",
      "eSIM triggers and temporal coupling are deliberately excluded from this experiment."
    ]
  }
